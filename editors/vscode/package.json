{
  "name": "mythoscode-vscode",
  "displayName": "MythosCode",
  "description": "Open MythosCode in the active workspace and prepare file context for review.",
  "version": "0.1.0",
  "publisher": "bigsmartie",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigSmartie/Coding-Agent.git",
    "directory": "editors/vscode"
  },
  "license": "MIT",
  "categories": ["Other"],
  "engines": { "vscode": "^1.85.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:mythoscode.openWorkspace",
    "onCommand:mythoscode.openCurrentFile"
  ],
  "contributes": {
    "commands": [
      { "command": "mythoscode.openWorkspace", "title": "MythosCode: Open in Workspace" },
      { "command": "mythoscode.openCurrentFile", "title": "MythosCode: Review Current File" }
    ],
    "configuration": {
      "title": "MythosCode",
      "properties": {
        "mythoscode.executablePath": {
          "type": "string",
          "default": "mythoscode",
          "scope": "application",
          "description": "User-level MythosCode executable path. Workspace settings cannot override it."
        }
      }
    }
  },
  "scripts": { "test": "node --test" }
}
