{
  "name": "mycode-vscode",
  "displayName": "MyCode",
  "description": "Open MyCode in the active workspace and prepare file context for review.",
  "version": "0.1.0",
  "publisher": "bigsmartie",
  "repository": {
    "type": "git",
    "url": "https://github.com/BigSmartie/Coding-Agent.git",
    "directory": "editors/vscode"
  },
  "license": "MIT",
  "categories": ["Other"],
  "engines": { "vscode": "^1.85.0" },
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:mycode.openWorkspace",
    "onCommand:mycode.openCurrentFile"
  ],
  "contributes": {
    "commands": [
      { "command": "mycode.openWorkspace", "title": "MyCode: Open in Workspace" },
      { "command": "mycode.openCurrentFile", "title": "MyCode: Review Current File" }
    ],
    "configuration": {
      "title": "MyCode",
      "properties": {
        "mycode.executablePath": {
          "type": "string",
          "default": "mycode",
          "scope": "application",
          "description": "User-level MyCode executable path. Workspace settings cannot override it."
        }
      }
    }
  },
  "scripts": { "test": "node --test" }
}
